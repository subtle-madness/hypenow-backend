          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hypenow-prometheus"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "1h API 5xx",
          "expr": "clamp_min((sum(http_server_requests_seconds_count{status=~\"5..\",uri!~\"UNKNOWN|root|/actuator.*\"}) or vector(0)) - (sum(http_server_requests_seconds_count{status=~\"5..\",uri!~\"UNKNOWN|root|/actuator.*\"} offset 1h) or vector(0)), 0) and on() up{job=\"was\"} == 1"
        }
      ]
