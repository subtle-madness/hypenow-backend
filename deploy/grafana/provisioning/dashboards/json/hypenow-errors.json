          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{code}}",
          "expr": "sum by (code) (count_over_time({service=~\"crawler|monitoring\", level=~\"WARN|ERROR\"} |~ `(?:HTTP|Hiker) [0-9]{3}` | regexp `(?:HTTP|Hiker) (?P<code>[0-9]{3})` [$__auto]))"
