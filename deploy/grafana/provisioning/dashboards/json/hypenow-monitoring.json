    {
      "id": 1,
      "type": "stat",
      "title": "마지막 스윕",
      "description": "마지막 성공 스윕(sweep_run.ok)으로부터 경과 시간 — 홈 타일5와 같은 쿼리다. 스윕은 매일 새벽 1회라 26시간을 넘으면 어젯밤 스윕이 안 돈 것이다. 값이 아예 없으면(성공 이력 0건) '데이터 없음'을 빨강으로 띄운다 — 무값은 초록이 아니다.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "hypenow-monitoring-pg"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "데이터 없음",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "데이터 없음",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ],
          "unit": "h",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 26
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "hypenow-monitoring-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT EXTRACT(EPOCH FROM (now() - max(started_at)))/3600 AS value FROM sweep_run WHERE ok"
        }
      ]
    },
    {
      "id": 2,
