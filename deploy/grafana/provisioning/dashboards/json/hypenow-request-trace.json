{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "최근 에러 요청 (진입점)",
      "description": "시간 범위 안에서 ERROR 로그를 남긴 requestId 목록(요청별 에러 줄 수, 상위 50). request_id 셀을 클릭하면 아래 로그 패널이 그 요청으로 필터된다. 정규식은 correlation 슬롯 앵커(대괄호 그룹 바로 뒤에 로거명과 ' : ')라 [모듈명]·[스레드명] 대괄호와 오인 매칭이 없고, requestId 없는 요청 밖 에러(빈 [])는 제외된다. **로컬 하니스는 Loki 스텁이라 이 대시보드 전체가 에러로 보이는 게 정상**(dev README '운영과 다른 점') — 검증은 운영에서.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "hypenow-loki" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "request_id" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "이 요청의 로그 보기",
                    "url": "/d/hypenow-request-trace/request-trace?var-request_id=${__data.fields.request_id}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "에러 줄 수", "desc": true }]
      },
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "Value": "에러 줄 수" },
            "indexByName": { "request_id": 0, "service": 1, "에러 줄 수": 2 }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "hypenow-loki" },
          "queryType": "instant",
          "instant": true,
          "expr": "topk(50, sum by (request_id, service) (count_over_time({service=~\"was|monitoring\", level=\"ERROR\"} | regexp `\\] \\[(?P<request_id>[A-Za-z0-9_-]{1,64})\\] \\S+\\s+: ` | request_id != `` [$__range])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "요청 로그 (was·monitoring 통합, 시간 오름차순)",
      "description": "상단 request_id 변수의 요청에 속한 두 모듈 로그를 시간순으로 보여준다 — 줄 간 타임스탬프 간격이 곧 구간 소요다(등록: was 접수 → monitoring 수신 → 프로필 콜 → 저장 → 백필 제출). 대괄호 포함 매칭([id])이라 메시지 본문의 우연한 8자와 안 섞인다. ID는 위 에러 테이블 클릭, 응답 X-Request-Id 헤더, 또는 로그 라인에서 복사.",
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "loki", "uid": "hypenow-loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Ascending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "hypenow-loki" },
          "queryType": "range",
          "expr": "{service=~\"was|monitoring\"} |= `[$request_id]`"
        }
      ]
    }
  ],
  "refresh": "",
  "schemaVersion": 39,
  "tags": ["hypenow", "request-trace"],
  "templating": {
    "list": [
      {
        "name": "request_id",
        "label": "요청 ID",
        "description": "추적할 요청의 8자 ID(또는 X-Request-Id로 넘긴 값). 기본값 ?는 어떤 ID와도 매칭되지 않는다 — 입력 전 빈 화면이 의도. 빈 값으로 두면 요청 밖 로그([])만 나오니 지우지 말 것.",
        "type": "textbox",
        "query": "?",
        "current": { "text": "?", "value": "?" },
        "options": []
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "Asia/Seoul",
  "title": "요청 추적",
  "uid": "hypenow-request-trace"
}
