    {
      "id": 1,
      "type": "stat",
      "title": "브랜드 스윕 신선도",
      "description": "활성 브랜드의 마지막 스윕 성공 시각 기준. 26h 초과 = 어젯밤 02:00 KST 브랜드 스윕 불발(08-10 Hiker 402 고착 같은 사고). 클릭 → 없음(이 장이 착지).",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "hypenow-monitoring-pg"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "데이터 없음",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "데이터 없음",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ],
          "unit": "h",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 26
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "hypenow-monitoring-pg"
          },
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT EXTRACT(EPOCH FROM (now() - max(last_swept_at)))/3600 AS value FROM brand_account WHERE closed_at IS NULL"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "오늘 스윕 성공",
      "description": "오늘(KST) 스윕이 성공한 브랜드 수 / 활성 브랜드 수. 실패 브랜드는 last_swept_on이 갱신되지 않아 차이로 드러난다.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "hypenow-monitoring-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "hypenow-monitoring-pg"
          },
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT count(*) FILTER (WHERE last_swept_on = (now() AT TIME ZONE 'Asia/Seoul')::date) AS \"성공\", count(*) FILTER (WHERE closed_at IS NULL) AS \"활성 전체\" FROM brand_account"
        }
      ]
    },
