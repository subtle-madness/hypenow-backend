          "rawSql": "SELECT count(*) FILTER (WHERE (registered_at AT TIME ZONE 'Asia/Seoul')::date = (now() AT TIME ZONE 'Asia/Seoul')::date) AS \"오늘\", count(*) FILTER (WHERE registered_at > now() - interval '7 days') AS \"이번주\" FROM brand_account"
        }
