          "datasource": {
            "type": "postgres",
            "uid": "hypenow-monitoring-pg"
          },
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT username AS \"브랜드\", last_swept_at AS \"성공 시각\", round(EXTRACT(EPOCH FROM (last_swept_at - lag(last_swept_at) OVER (ORDER BY last_swept_at)))::numeric,1) AS \"간격(초)\" FROM brand_account WHERE last_swept_on = (now() AT TIME ZONE 'Asia/Seoul')::date ORDER BY last_swept_at"
        }
      ]
