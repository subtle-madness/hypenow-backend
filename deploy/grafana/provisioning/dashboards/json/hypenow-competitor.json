          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "hypenow-monitoring-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT started_at AS time,\n       EXTRACT(EPOCH FROM (completed_at - started_at))/60 AS \"소요(분)\"\nFROM sweep_run\nWHERE started_at > now() - interval '30 days'\nORDER BY 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "감지 전환 추이 30일",
      "description": "감시(WATCHING) 상태이던 계정 타깃이 게시물 감지로 추적(TRACKING)으로 넘어간 일별 건수(target.tracked_since 기준). **정보성 패널이지 신호등이 아니다 — 0이 정상일 수 있다**(그날 등록 타깃이 아무 것도 안 올렸으면 0이다). 대시보드 시간창과 무관하게 최근 30일 고정.",
