      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hypenow-prometheus"
          },
          "expr": "up{job=\"monitoring\"}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
