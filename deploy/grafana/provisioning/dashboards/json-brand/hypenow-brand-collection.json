          "datasource": {
            "type": "postgres",
            "uid": "hypenow-monitoring-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('day', first_seen_at AT TIME ZONE 'Asia/Seoul') AT TIME ZONE 'Asia/Seoul' AS time,\n       count(*) AS \"신규 태그 게시물\"\nFROM brand_tagged_post\nWHERE first_seen_at > now() - interval '30 days'\nGROUP BY 1 ORDER BY 1"
        }
      ]
