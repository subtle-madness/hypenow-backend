      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "hypenow-monitoring-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) FILTER (WHERE verdict = 'RELEVANT')  AS \"관련\",\n       count(*) FILTER (WHERE verdict = 'UNCERTAIN') AS \"불확실\",\n       count(*) FILTER (WHERE verdict = 'IRRELEVANT') AS \"무관\",\n       count(*) FILTER (WHERE verdict IN ('SELF', 'DIRECT_TAGGED')) AS \"자사·직태그\"\nFROM brand_hashtag_post WHERE first_seen_at > now() - interval '7 days'"
        }
      ]
    },
