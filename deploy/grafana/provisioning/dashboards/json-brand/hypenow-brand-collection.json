    {
      "id": 12,
      "type": "table",
      "title": "오늘 게시물 갱신 — 티어별",
      "description": "'오늘 게시물 갱신' 스탯의 티어별 분해 — 행은 게시물 나이 티어(BrandCrawlPolicy: 14일 이내 매일, 30일 이내 3일마다, 90일 이내 7일마다, 180일 이내 30일마다, 180일 초과는 추적 종료·영구 제외), 열은 보유 = 오늘 처리 + 미처리 + 대기 분할. '오늘 처리'는 last_crawled_at이 KST 오늘, '미처리'는 지금 기준 갱신 기한(due)인데 오늘 안 돈 것, '대기'는 아직 주기가 안 지난 것(매일 티어는 정의상 0). **스윕은 매일 같은 시각에 돌고 due 판정은 정확히 주기 경과라, 스윕 슬롯이 직전 touch보다 몇 초만 일러도 그날 하루 미처리로 보였다가 다음 날 자동 수습된다(하루 밀림 — 08-23 실측 263건 전부 이 패턴).** 미처리가 이틀 이상 유지되거나 매일 티어에서 나오면 그때가 진짜 이상(수집 실패·중단)이다.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "hypenow-monitoring-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "noValue": "—",
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "미처리"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "hypenow-monitoring-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH posts AS (SELECT CASE WHEN t.taken_at >= now() - interval '14 days' THEN 1 WHEN t.taken_at >= now() - interval '30 days' THEN 2 WHEN t.taken_at >= now() - interval '90 days' THEN 3 WHEN t.taken_at >= now() - interval '180 days' THEN 4 ELSE 5 END AS tier, coalesce((t.last_crawled_at AT TIME ZONE 'Asia/Seoul')::date = (now() AT TIME ZONE 'Asia/Seoul')::date, false) AS done_today, (t.taken_at >= now() - interval '180 days' AND (t.last_crawled_at IS NULL OR t.taken_at >= now() - interval '14 days' OR (t.taken_at >= now() - interval '30 days' AND t.last_crawled_at <= now() - interval '3 days') OR (t.taken_at >= now() - interval '90 days' AND t.last_crawled_at <= now() - interval '7 days') OR t.last_crawled_at <= now() - interval '30 days')) AS due_now FROM brand_tagged_post t JOIN brand_account b ON b.id = t.brand_id AND b.closed_at IS NULL WHERE t.taken_at IS NOT NULL), agg AS (SELECT tier, count(*) AS held, count(*) FILTER (WHERE done_today) AS done, count(*) FILTER (WHERE NOT done_today AND due_now) AS pending, count(*) FILTER (WHERE NOT done_today AND NOT due_now) AS waiting FROM posts GROUP BY tier) SELECT \"티어\", \"보유\", \"오늘 대상\", \"오늘 처리\", \"미처리\", \"대기\" FROM (SELECT l.ord, l.label AS \"티어\", coalesce(a.held,0) AS \"보유\", coalesce(a.done,0)+coalesce(a.pending,0) AS \"오늘 대상\", coalesce(a.done,0) AS \"오늘 처리\", coalesce(a.pending,0) AS \"미처리\", coalesce(a.waiting,0) AS \"대기\" FROM (VALUES (1,'매일 (0–14일)'),(2,'3일 (14–30일)'),(3,'7일 (30–90일)'),(4,'30일 (90–180일)')) AS l(ord,label) LEFT JOIN agg a ON a.tier = l.ord UNION ALL SELECT 5, '추적 종료 (180일+)', coalesce((SELECT held FROM agg WHERE tier = 5),0), NULL, NULL, NULL, NULL UNION ALL SELECT 6, '합계 (0–180일)', coalesce(sum(held),0), coalesce(sum(done),0)+coalesce(sum(pending),0), coalesce(sum(done),0), coalesce(sum(pending),0), coalesce(sum(waiting),0) FROM agg WHERE tier <= 4) x ORDER BY x.ord"
        }
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "오늘 브랜드별 처리 현황",
      "description": "브랜드 일일 수집은 순차 처리 — 직전 브랜드와의 성공 시각 간격 ≈ 해당 브랜드 처리 시간(근사). 첫 행은 기준이 없어 공란. 특정 브랜드만 간격이 튀면 그 계정의 수집이 무거워진 것. 간격과 함께 브랜드별 수집량도 본다 — 오늘 Hiker 콜(과금 규모), 오늘 신규 게시물(그날 실제 유입), 누적 게시물(자산 규모). 콜만 많고 신규가 0이면 변화 없는 브랜드를 재확인만 한 것이라 정상일 수 있지만, 전 브랜드가 그러면 수집이 헛돌고 있는 것.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "postgres",
        "uid": "hypenow-monitoring-pg"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "오늘 일일 수집 기록 없음",
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "간격(초)"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "—"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "오늘 콜"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "—"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "hypenow-monitoring-pg"
          },
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT b.username AS \"브랜드\", b.last_swept_at AS \"성공 시각\", round(EXTRACT(EPOCH FROM (b.last_swept_at - lag(b.last_swept_at) OVER (ORDER BY b.last_swept_at)))::numeric,1) AS \"간격(초)\", c.calls AS \"오늘 콜\", coalesce(t.today_posts, 0) AS \"오늘 신규 게시물\", coalesce(t.total_posts, 0) AS \"누적 게시물\" FROM brand_account b LEFT JOIN brand_call_count c ON c.brand_id = b.id AND c.called_on = (now() AT TIME ZONE 'Asia/Seoul')::date LEFT JOIN (SELECT brand_id, count(*) FILTER (WHERE (first_seen_at AT TIME ZONE 'Asia/Seoul')::date = (now() AT TIME ZONE 'Asia/Seoul')::date) AS today_posts, count(*) AS total_posts FROM brand_tagged_post GROUP BY brand_id) t ON t.brand_id = b.id WHERE b.last_swept_on = (now() AT TIME ZONE 'Asia/Seoul')::date ORDER BY b.last_swept_at"
        }
      ]
    },
