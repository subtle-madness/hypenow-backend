    {
      "id": 1,
      "type": "stat",
      "title": "오늘 신규 태그 게시물",
      "description": "오늘(KST 달력일) 새로 적재된 브랜드 태그 게시물 수. 0이면 브랜드 일일 수집이 돌지 않은 것 — 02:00 KST 일일 수집 불발이나 Hiker 잔액 소진(08-10 402 고착)을 의심한다. first_seen_at은 UTC 저장이라 KST 달력일로 환산해 비교한다.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "hypenow-monitoring-pg"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "데이터 없음",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "0 — 일일 수집 확인",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "데이터 없음",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "unit": "locale",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
