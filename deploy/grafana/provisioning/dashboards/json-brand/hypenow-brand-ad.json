    {
      "id": 1,
      "type": "stat",
      "title": "오늘 판정 건수",
      "description": "오늘(KST 달력일) 광고 표기 판정이 붙은 게시물 수. 0이면 판정 잡이 한 건도 돌지 않은 것 — 신규 판정과 백필이 함께 멈춘 상태다. ad_judged_at은 UTC 저장이라 KST 달력일로 환산해 비교한다.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "hypenow-monitoring-pg"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "데이터 없음",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "0 — 판정 잡 확인",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "데이터 없음",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "unit": "locale",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
