      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "hypenow-monitoring-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ad_judged_at AS \"판정 시각\", short_code AS \"게시물\", username AS \"작성자\",\n       ad_violations::text AS \"위반 코드\"\nFROM brand_post_meta WHERE ad_verdict = 'NOT_DISCLOSED'\nORDER BY ad_judged_at DESC LIMIT 15"
        }
      ]
    }
  ]
