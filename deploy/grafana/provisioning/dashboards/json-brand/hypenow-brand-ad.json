        "colorMode": "background",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "hypenow-monitoring-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS value FROM brand_post_meta\nWHERE (ad_judged_at AT TIME ZONE 'Asia/Seoul')::date = (now() AT TIME ZONE 'Asia/Seoul')::date"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "미판정 잔여",
      "description": "아직 판정이 붙지 않은 게시물 수(judged_caption_hash IS NULL). 08-17 신설 이후 과거 게시물 백필이 진행 중이라 **큰 수가 정상**이다 — 신호등이 아니라 진척 게이지라서 색 임계를 달지 않는다(스펙 §3-3 예외 승인). 이 수가 며칠째 줄지 않으면 그때 판정 잡을 의심한다.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "hypenow-monitoring-pg"
      },
