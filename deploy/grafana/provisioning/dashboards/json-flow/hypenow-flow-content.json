    {
      "id": 201,
      "type": "stat",
      "title": "분석 산출",
      "description": "content_analyses에 새로 쌓인 분석 결과 수(KST 달력일·최근 7일). 산출량 지표다 — 며칠째 0이면 분석 잡이 멈춘 것. ⚠️ '분석 잔여 몇 건'은 이 장에 없다: 미분석 후보 판정(v_analysis_candidates.timely)은 crawler DB, 기분석 셋은 analysis DB라 크로스 DB 셋 대조가 필요해 대시보드 단일 쿼리로는 못 세고, analytics/check/pending.sh가 정본이다(단독 카운트는 '제때창 놓쳐 영구 제외'와 '대기'를 뭉갠다).",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "hypenow-analysis-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "noValue": "데이터 없음",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "hypenow-analysis-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE (analyzed_at AT TIME ZONE 'Asia/Seoul')::date = (now() AT TIME ZONE 'Asia/Seoul')::date) AS \"오늘\", count(*) FILTER (WHERE analyzed_at > now() - interval '7 days') AS \"7일\" FROM content_analyses"
        }
      ]
    },
    {
      "id": 202,
      "type": "timeseries",
      "title": "분석 산출 추이 30일",
      "description": "일별 신규 분석 결과 수(KST 달력일 경계, 대시보드 시간창 무관 30일 고정). 특정 날짜만 0이면 그날 분석 잡이 멈춘 것. 백필·재분석이 돌면 그날에 몰려 찍히는 게 정상.",
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "hypenow-analysis-pg"
      },
      "timeFrom": "30d",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "barAlignment": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "hypenow-analysis-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', analyzed_at AT TIME ZONE 'Asia/Seoul') AT TIME ZONE 'Asia/Seoul' AS time, count(*) AS \"신규 분석\" FROM content_analyses WHERE analyzed_at > now() - interval '30 days' GROUP BY 1 ORDER BY 1"
        }
      ]
    },
