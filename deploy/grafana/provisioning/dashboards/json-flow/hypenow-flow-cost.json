          },
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{backend}} {{outcome}}",
          "expr": "sum by (backend, outcome) (rate(instagram_source_route_total{job=\"monitoring\"}[5m]))"
        }
      ]
    },
    {
      "id": 402,
      "type": "stat",
      "title": "self 폴백 비율 (hiker fallback:* / self 시도 전체, 1h)",
      "description": "self 건전성은 self 시리즈 유무가 아니라 이 비율로 본다(self 워크로드가 없으면 self 시리즈도 없다). 분모=self 시도 전체(backend=self 전체 outcome + hiker로 넘어간 fallback:*), 분자=그중 폴백. 09-04 self 사망 오진(실제론 워크로드 소진)처럼 self 라인이 안 보이는 것과 실제 장애를 이 숫자로 구분한다.",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hypenow-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "noValue": "데이터 없음 (self 시도 없음)",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hypenow-prometheus"
          },
          "editorMode": "code",
          "range": true,
          "expr": "sum(increase(instagram_source_route_total{job=\"monitoring\", outcome=~\"fallback:.*\"}[1h])) / (sum(increase(instagram_source_route_total{job=\"monitoring\", backend=\"self\"}[1h])) + sum(increase(instagram_source_route_total{job=\"monitoring\", outcome=~\"fallback:.*\"}[1h])))"
        }
      ]
    },
    {
