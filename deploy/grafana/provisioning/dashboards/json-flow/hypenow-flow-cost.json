            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "topk(15, sum by (logger) (count_over_time({service=~\"crawler|monitoring\", level=~\"WARN|ERROR\"} | regexp `\\] (?P<logger>[\\w.]+)\\s+: ` [$__range])))"
        }
      ]
    },
