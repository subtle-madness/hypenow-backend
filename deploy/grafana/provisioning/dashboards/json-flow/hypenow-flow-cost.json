    {
      "id": 304,
      "type": "stat",
      "title": "Hiker 402 (잔액 소진)",
      "description": "1건이라도 뜨면 사람이 충전해야 한다. 08-10에 이 상태로 브랜드 스윕 4건이 collecting에 고착했다.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "loki",
        "uid": "hypenow-loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "sum(count_over_time({service=~\"crawler|monitoring\"} |~ `(?:HTTP|Hiker) 402` [$__auto]))"
        }
      ]
    },
