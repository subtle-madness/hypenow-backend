# 전역 옵션 — 에러 로그의 자격증명 헤더 제거 (2026-07-31)
# 사이트 블록의 `log`에 건 format filter는 **액세스 로그에만** 적용된다. 업스트림 dial
# 실패(502) 등에서 나오는 `http.log.error.*` 항목은 사이트 로거가 아니라 기본 로거를 타고
# stderr → docker json-file로 나가서, 아래 fields 목록이 걸리지 않는다(07-31 로컬 실측).
# 기본 로거에 직접 필터를 걸면(`log { format filter ... }`) caddy 자체 로그(기동·tls·admin)까지
# 출력이 JSON→console로 전면 변경되므로, 에러 네임스페이스만 전용 로거로 분리해 필터를 건다.
# `wrap json`이라 기존 stderr 형식(JSON 한 줄)은 그대로다. caddy.d/*의 test 도메인도 같은
# 기본 로거를 타므로 이 한 곳으로 운영·test가 함께 덮인다.
# Cookie·Authorization은 caddy가 기본으로 `REDACTED` 치환하므로 목록에 없다(값 노출 없음 +
# "자격증명이 붙어 있었다"는 사실은 남아 디버깅에 유리). 커스텀 헤더는 그 대상이 아니다.
{
	log default {
		# caddy adapt가 named 로거의 include 대상을 default.exclude에 자동 추가하므로 이 줄이
		# 없어도 산출 JSON은 동일하다(v2.11.4 실측). 그래도 명시하는 이유: 이 필터의 유일한
		# 실패 모드가 "기본 로거에 걸러지지 않은 사본이 함께 남는 것"이라, 그 자동 동작에
		# 버전 의존을 걸지 않는다.
		exclude http.log.error
	}
	log errors {
		include http.log.error
		format filter {
			wrap json
			fields {
				request>headers>X-Xsrf-Token delete
				request>headers>X-Api-Token delete
			}
		}
	}
}

{$API_DOMAIN} {
	# 액세스 로그(2026-07-29) — 전 요청의 경로·상태·소요시간 전수 기록(JSON, 롤링 캡 ~250MB).
	# 자격증명 헤더(세션 쿠키·인증·CSRF·수동 발굴 토큰)는 로그에 절대 남기지 않는다.
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Xsrf-Token delete
				# 아래 /crawler/api/manual-discoveries의 인증 헤더 — 세션과 무관한 단독
				# 정적 시크릿이라 이게 새면 그것만으로 등록 API를 호출할 수 있다.
				request>headers>X-Api-Token delete
				resp_headers>Set-Cookie delete
			}
		}
	}
	# OCI ONS 알람 → 디스코드 릴레이 (경로 토큰은 릴레이가 검증)
	handle /internal/ons-relay/* {
		reverse_proxy ons-relay:9099
	}
	# 크롬 익스텐션 수동 발굴 등록 — crawler에서 이 경로만 외부 공개(토큰은 crawler가 검증)
	handle /crawler/api/manual-discoveries {
		uri strip_prefix /crawler
		reverse_proxy crawler:8080
	}
	handle {
		# 롤링 배포(scripts/rollout.sh) 중 신구 was 교대 순간의 dial 실패를 재시도로 흡수 —
		# 도커 DNS가 재해석돼 살아 있는 쪽에 붙는다. 평상시엔 무영향(성공한 요청은 재시도 없음).
		reverse_proxy was:8081 {
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}
}

# dev 등 부가 라우팅은 caddy.d/*.caddy로 분리 — dev CD가 dev 파일만 갱신·리로드하므로
# 이 본 파일(운영 라우팅)은 main 배포로만 바뀐다. glob이라 파일이 없어도 무해.
import /etc/caddy/caddy.d/*.caddy
