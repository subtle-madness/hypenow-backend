{$API_DOMAIN} {
	# OCI ONS 알람 → 디스코드 릴레이 (경로 토큰은 릴레이가 검증)
	handle /internal/ons-relay/* {
		reverse_proxy ons-relay:9099
	}
	# 크롬 익스텐션 수동 발굴 등록 — crawler에서 이 경로만 외부 공개(토큰은 crawler가 검증)
	handle /crawler/api/manual-discoveries {
		uri strip_prefix /crawler
		reverse_proxy crawler:8080
	}
	handle {
		reverse_proxy was:8081
	}
}

# dev 등 부가 라우팅은 caddy.d/*.caddy로 분리 — dev CD가 dev 파일만 갱신·리로드하므로
# 이 본 파일(운영 라우팅)은 main 배포로만 바뀐다. glob이라 파일이 없어도 무해.
import /etc/caddy/caddy.d/*.caddy
