# 서버의 deploy/.env 로 복사해 실제 값 기입 (deploy/.env 는 커밋 금지)
DB_USER=celfit
DB_PASSWORD=change-me
API_DOMAIN=api.hypenow.io
# raw DB (postgres-raw)
RAW_DB_USER=crawler
RAW_DB_PASSWORD=change-me
# was 이메일 발송(선택)
RESEND_API_KEY=
# 주간 리포트 메일 딥링크 기준 주소(선택) — 미기입 시 compose 기본값(운영 https://www.hypenow.io,
# 스테이징 https://dev.hypenow.io)을 쓴다
WEB_BASE_URL=
DEV_WEB_BASE_URL=
# 주간 다이제스트 생성·발송 크론(선택, README §13-5-3) — 미기입 시 compose 기본값(매주 월요일
# 09:00 KST + 따라잡기 09:10~23:50 10분 간격)을 쓴다. 임시 중단은 두 크론을 모두 "-"로 채울 것
MONITORING_DIGEST_WEEKLY_CRON=
MONITORING_DIGEST_WEEKLY_CATCHUP_CRON=
DEV_MONITORING_DIGEST_WEEKLY_CRON=
DEV_MONITORING_DIGEST_WEEKLY_CATCHUP_CRON=
# analytics LLM
GEMINI_API_KEY=
# crawler (수집) — Apify 필수, 나머지는 쓰는 소스만
APIFY_TOKEN=
HIKER_API_KEY=
DATALIKERS_API_KEY=
ANTHROPIC_AUTH_TOKEN=
APIFY_PROXY_URL=
DATAIMPULSE_RESIDENTIAL_PROXY_URL=
DATAIMPULSE_MOBILE_PROXY_URL=
# monitoring 자체크롤 댓글 graphql 파라미터(마일스톤 C 개통 시 기입 — B에선 미사용)
IG_COMMENT_DOC_ID=
IG_COMMENT_FRIENDLY_NAME=
# 이미지 아카이브 쓰기 PAR URL (/o/ 로 끝남 — 태스크 J)
ANALYTICS_IMAGE_PAR_URL=
# 이미지 스토어(2026-08-12 GCS 이전): par|gcs. 두 서비스(analytics·monitoring) 공통 스위치.
# gcs면 IMAGE_GCS_BUCKET 필수. IMAGE_GCS_KEY는 미설정(빈 값 포함) 시 컨테이너 기본 경로
# /run/secrets/gcs-image-archiver.json 을 쓴다 — 키 실물은 deploy/secrets/gcs-image-archiver.json
# (par 모드에서도 빈 파일이라도 만들어 둘 것: 없으면 docker가 마운트 소스를 root 소유 빈
# 디렉토리로 만든다). 복귀는 par로 원복.
# analytics의 GOOGLE_APPLICATION_CREDENTIALS(vertex-sa.json)와는 무관 — 인증 경로가 분리돼 있다.
IMAGE_STORE=par
IMAGE_GCS_BUCKET=
IMAGE_GCS_KEY=
# monitoring 사설 DB (postgres 인스턴스 내 별도 DB — 개통 절차는 README §13.
# 미기입 시 compose 동기화 검증에서 CD가 실패한다. HIKER_API_KEY도 실값 필요)
MONITORING_DB_USER=monitoring
MONITORING_DB_PASSWORD=change-me
# was v3 모니터링 조회 — monitoring DB 읽기 전용 롤(was_reader, 개통 절차는 README §13-6). 미개통 시 비워 둬도 된다(MONITORING_ENABLED=false)
WAS_READER_PASSWORD=
DEV_WAS_READER_PASSWORD=
# Grafana 서비스 현황 대시보드 (개통 절차는 README §14) — SSH 터널 전용이라 도메인·DNS 불필요
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
# analysis DB 읽기 전용 롤(grafana_reader, app 스키마 SELECT만 — README §14 런북에서 수동 생성)
GRAFANA_READER_PASSWORD=
